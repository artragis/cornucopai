{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cornucopai.local/contracts/atelier-schema.json",
  "title": "Atelier — persisted as atelier.json inside atelier{yyyyMMdd-HHmmss}/ (spec 002 R-002, spec 003 R-016)",
  "description": "Extended by spec 003: adds language, selectedFamilies, sets (resolved language per set), and changes deck from an array of placeholder strings to an array of full Card objects (real cards, id + description persisted here).",
  "type": "object",
  "required": ["id", "createdAt", "featureHtml", "playerCount", "players", "turnOrder", "language", "selectedFamilies", "deck", "sets"],
  "properties": {
    "id": { "type": "string", "example": "atelier2026-11-08-091500" },
    "createdAt": { "type": "string", "format": "date-time" },
    "featureHtml": { "type": "string" },
    "playerCount": { "type": "integer", "minimum": 2 },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "archetype"],
        "properties": {
          "name": { "type": "string", "example": "Joueur-1" },
          "archetype": { "type": "string", "enum": ["GRUMPY", "HAPPY", "GREEDY", "PROF"] }
        }
      }
    },
    "turnOrder": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "description": "Chosen language, lowercase, default fr", "example": "fr" },
    "selectedFamilies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "example": "webapp:VE" },
      "description": "Selected families as setId:familyId pairs (FR-005)"
    },
    "deck": {
      "type": "array",
      "description": "Real dealt cards — full Card objects; id + description are persisted here (R-016)",
      "items": { "$ref": "#/definitions/Card" }
    },
    "sets": {
      "type": "array",
      "description": "Resolved language per set used in this game (FR-017)",
      "items": {
        "type": "object",
        "required": ["id", "resolvedLanguage"],
        "properties": {
          "id": { "type": "string", "example": "webapp" },
          "resolvedLanguage": { "type": "string", "example": "fr" }
        }
      }
    },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "definitions": {
    "Card": {
      "type": "object",
      "required": ["id", "value", "setId", "suitId", "suitName", "language", "description"],
      "properties": {
        "id": { "type": "string", "example": "VE2" },
        "value": { "type": "string", "example": "2" },
        "setId": { "type": "string", "example": "webapp" },
        "suitId": { "type": "string", "example": "VE" },
        "suitName": { "type": "string", "example": "DATA VALIDATION & ENCODING" },
        "language": { "type": "string", "example": "fr" },
        "description": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "misc": { "type": ["string", "null"] }
      }
    }
  }
}
